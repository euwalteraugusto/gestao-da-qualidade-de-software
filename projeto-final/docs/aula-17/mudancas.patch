@@ -0,0 +1,52 @@
+package com.example.projeto.web;
+
+import com.example.projeto.domain.service.ProdutoService;
+import jakarta.validation.Valid;
+import lombok.RequiredArgsConstructor;
+import org.springframework.stereotype.Controller;
+import org.springframework.ui.Model;
+import org.springframework.validation.BindingResult;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.ModelAttribute;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+
+/**
+ * Interface web server-side (Thymeleaf) de produtos.
+ * <p>
+ * Nome {@code ProdutoWebController} (o slide usa {@code ProdutoController}): ja existe
+ * um bean {@code produtoController} na API REST e dois beans com o mesmo nome
+ * impedem a aplicacao de subir ({@code ConflictingBeanDefinitionException}).
+ */
+@Controller
+@RequestMapping("/produtos")
+@RequiredArgsConstructor
+public class ProdutoWebController {
+
+    static final String VIEW_LISTA = "produtos/lista";
+    static final String VIEW_FORM = "produtos/form";
+
+    private final ProdutoService service;
+
+    @GetMapping
+    public String listar(Model model) {
+        model.addAttribute("produtos", service.listarTodos());
+        return VIEW_LISTA;
+    }
+
+    @GetMapping("/novo")
+    public String novo(Model model) {
+        model.addAttribute("form", new ProdutoForm());
+        return VIEW_FORM;
+    }
+
+    /** PRG (Post/Redirect/Get): apos salvar redireciona, evitando reenvio com F5. */
+    @PostMapping("/cadastrar")
+    public String cadastrar(@Valid @ModelAttribute("form") ProdutoForm form, BindingResult result) {
+        if (result.hasErrors()) {
+            return VIEW_FORM;
+        }
+        service.cadastrar(form.toEntity());
+        return "redirect:/produtos";
+    }
+}
diff --git a/projeto-final/src/main/java/com/example/projeto/web/WebExceptionHandler.java b/projeto-final/src/main/java/com/example/projeto/web/WebExceptionHandler.java
new file mode 100644
index 0000000000000000000000000000000000000000..fdb7a0a6edc3366f25ffef2580bdf10b7bff12b3
--- /dev/null
+++ b/projeto-final/src/main/java/com/example/projeto/web/WebExceptionHandler.java
@@ -0,0 +1,50 @@
+package com.example.projeto.web;
+
+import com.example.projeto.integration.CepNaoEncontradoException;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.http.HttpStatus;
+import org.springframework.ui.Model;
+import org.springframework.web.bind.annotation.ControllerAdvice;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.client.RestClientException;
+
+/**
+ * Tratamento de erros das paginas web (Thymeleaf). Restrito ao pacote {@code web}
+ * para nao interferir na API REST, que responde JSON (ProblemDetail).
+ * <p>
+ * Diferenca em relacao ao slide: alem de mostrar a pagina de erro, define o status
+ * HTTP correto (o slide devolvia a pagina "error" com status 200).
+ */
+@ControllerAdvice(basePackages = "com.example.projeto.web")
+public class WebExceptionHandler {
+
+    private static final Logger log = LoggerFactory.getLogger(WebExceptionHandler.class);
+    private static final String VIEW_ERRO = "error";
+
+    @ExceptionHandler(RestClientException.class)
+    @ResponseStatus(HttpStatus.BAD_GATEWAY)
+    public String handleApiError(RestClientException ex, Model model) {
+        log.warn("Falha ao consultar API externa: {}", ex.getMessage());
+        model.addAttribute("error", "Falha ao consultar API externa");
+        model.addAttribute("status", HttpStatus.BAD_GATEWAY.value());
+        return VIEW_ERRO;
+    }
+
+    @ExceptionHandler(CepNaoEncontradoException.class)
+    @ResponseStatus(HttpStatus.NOT_FOUND)
+    public String handleCepNaoEncontrado(CepNaoEncontradoException ex, Model model) {
+        model.addAttribute("error", ex.getMessage());
+        model.addAttribute("status", HttpStatus.NOT_FOUND.value());
+        return VIEW_ERRO;
+    }
+
+    @ExceptionHandler(IllegalArgumentException.class)
+    @ResponseStatus(HttpStatus.BAD_REQUEST)
+    public String handleEntradaInvalida(IllegalArgumentException ex, Model model) {
+        model.addAttribute("error", ex.getMessage());
+        model.addAttribute("status", HttpStatus.BAD_REQUEST.value());
+        return VIEW_ERRO;
+    }
+}
