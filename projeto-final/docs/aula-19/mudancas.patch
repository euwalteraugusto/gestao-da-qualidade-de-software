diff --git a/projeto-final/src/main/java/com/example/projeto/health/ApiExternaHealthIndicator.java b/projeto-final/src/main/java/com/example/projeto/health/ApiExternaHealthIndicator.java
new file mode 100644
index 0000000000000000000000000000000000000000..fc7deaa9541e62f040aab453c20b19207d871dd3
--- /dev/null
+++ b/projeto-final/src/main/java/com/example/projeto/health/ApiExternaHealthIndicator.java
@@ -0,0 +1,48 @@
+package com.example.projeto.health;
+
+import com.example.projeto.integration.CepService;
+import com.example.projeto.integration.Endereco;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.actuate.health.Health;
+import org.springframework.boot.actuate.health.HealthIndicator;
+import org.springframework.stereotype.Component;
+
+/**
+ * Indicador de saude customizado (aula 19): verifica se a API externa ViaCEP
+ * responde, consultando um CEP de referencia. Aparece em {@code /actuator/health}
+ * como o componente {@code apiExterna} (nome do bean sem o sufixo "HealthIndicator").
+ * <p>
+ * O slide deixava {@code checkApiExterna()} indefinido e usava comentarios com
+ * {@code #} dentro do Java (nao compila).
+ */
+@Component
+public class ApiExternaHealthIndicator implements HealthIndicator {
+
+    private final CepService cepService;
+    private final String cepReferencia;
+
+    public ApiExternaHealthIndicator(CepService cepService,
+                                     @Value("${app.health.cep-referencia:01001000}") String cepReferencia) {
+        this.cepService = cepService;
+        this.cepReferencia = cepReferencia;
+    }
+
+    @Override
+    public Health health() {
+        long inicio = System.nanoTime();
+        try {
+            Endereco endereco = cepService.buscarPorCep(cepReferencia);
+            return Health.up()
+                    .withDetail("api", "ViaCEP")
+                    .withDetail("cepReferencia", endereco.cep())
+                    .withDetail("tempoRespostaMs", (System.nanoTime() - inicio) / 1_000_000)
+                    .build();
+        } catch (RuntimeException e) {
+            return Health.down()
+                    .withDetail("api", "ViaCEP")
+                    .withDetail("erro", "API externa indisponivel")
+                    .withDetail("causa", e.getClass().getSimpleName())
+                    .build();
+        }
+    }
+}
diff --git a/projeto-final/src/main/resources/application-prod.yml b/projeto-final/src/main/resources/application-prod.yml
new file mode 100644
index 0000000000000000000000000000000000000000..3e328bdac65ff076f7f70f8d94c41bab3f5d7ba3
--- /dev/null
+++ b/projeto-final/src/main/resources/application-prod.yml
@@ -0,0 +1,35 @@
+# Perfil de PRODUCAO (Heroku/AWS): SPRING_PROFILES_ACTIVE=prod (o Procfile ja passa o perfil).
+# Nao ha defaults para segredos: sem JWT_SECRET, ADMIN_PASSWORD_HASH e CLIENTE_PASSWORD_HASH
+# a aplicacao NAO sobe (falha rapida em vez de rodar com credenciais de desenvolvimento).
+spring:
+  datasource:
+    # Heroku Postgres: o buildpack Java exporta JDBC_DATABASE_URL/USERNAME/PASSWORD.
+    # Sem banco provisionado cai para H2 em memoria (somente demonstracao - dados se perdem no restart).
+    url: ${JDBC_DATABASE_URL:jdbc:h2:mem:produtos;DB_CLOSE_DELAY=-1}
+    username: ${JDBC_DATABASE_USERNAME:sa}
+    password: ${JDBC_DATABASE_PASSWORD:}
+  jpa:
+    hibernate:
+      ddl-auto: update
+
+server:
+  # Heroku informa a porta em $PORT
+  port: ${PORT:8080}
+  forward-headers-strategy: framework
+
+management:
+  endpoint:
+    health:
+      # Em producao detalhes (componentes, erros) so para ADMIN autenticado
+      show-details: when-authorized
