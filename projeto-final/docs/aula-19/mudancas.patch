diff --git a/projeto-final/src/test/java/com/example/projeto/health/ActuatorIT.java b/projeto-final/src/test/java/com/example/projeto/health/ActuatorIT.java
new file mode 100644
index 0000000000000000000000000000000000000000..2ad84ff233524429f3b225ee3e3f06b8e2b695a3
--- /dev/null
+++ b/projeto-final/src/test/java/com/example/projeto/health/ActuatorIT.java
@@ -0,0 +1,83 @@
+package com.example.projeto.health;
+
+import com.example.projeto.integration.CepService;
+import com.example.projeto.integration.Endereco;
+import com.example.projeto.support.MockMvcComJwt;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.mock.mockito.MockBean;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.web.client.ResourceAccessException;
+import org.springframework.web.context.WebApplicationContext;
+
+import static org.hamcrest.Matchers.is;
+import static org.hamcrest.Matchers.notNullValue;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+/**
+ * Endpoints do Actuator (aula 19): health com indicador customizado, info e metrics protegido.
+ * A API externa e mockada para o teste nao depender da internet.
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+class ActuatorIT {
+
+    @Autowired
+    MockMvc mockMvc;
+
+    @Autowired
+    WebApplicationContext contexto;
+
+    @MockBean
+    CepService cepService;
+
+    @BeforeEach
+    void apiExternaNoAr() {
+        when(cepService.buscarPorCep("01001000"))
+                .thenReturn(new Endereco("01001-000", "Praca da Se", null, "Se", "Sao Paulo", "SP", null));
+    }
+
+    @Test
+    void healthPublicoComComponentesApiExternaEDb() throws Exception {
+        mockMvc.perform(get("/actuator/health"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.status", is("UP")))
+                .andExpect(jsonPath("$.components.apiExterna.status", is("UP")))
+                .andExpect(jsonPath("$.components.db.status", is("UP")))
+                .andExpect(jsonPath("$.components.db.details.validationQuery", is("SELECT 1")));
+    }
+
+    @Test
+    void healthDownQuandoApiExternaCai() throws Exception {
+        when(cepService.buscarPorCep("01001000")).thenThrow(new ResourceAccessException("timeout"));
+
+        mockMvc.perform(get("/actuator/health"))
+                .andExpect(status().isServiceUnavailable())
+                .andExpect(jsonPath("$.components.apiExterna.status", is("DOWN")))
+                .andExpect(jsonPath("$.components.apiExterna.details.erro", is("API externa indisponivel")));
+    }
+
+    @Test
+    void infoPublicoComVersao() throws Exception {
+        mockMvc.perform(get("/actuator/info"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.app.name", is("projeto-final")))
+                .andExpect(jsonPath("$.app.version", notNullValue()));
+    }
+
+    @Test
+    void metricsExigeAdmin() throws Exception {
+        mockMvc.perform(get("/actuator/metrics")).andExpect(status().isUnauthorized());
+        MockMvcComJwt.criar(contexto, "cliente").perform(get("/actuator/metrics"))
+                .andExpect(status().isForbidden());
+        MockMvcComJwt.criar(contexto, "admin").perform(get("/actuator/metrics"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$.names", notNullValue()));
+    }
+}
diff --git a/projeto-final/src/test/java/com/example/projeto/health/ApiExternaHealthIndicatorTest.java b/projeto-final/src/test/java/com/example/projeto/health/ApiExternaHealthIndicatorTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..19e6d75f7ef5fdb2ca50b712334ddd34558d78e2
--- /dev/null
+++ b/projeto-final/src/test/java/com/example/projeto/health/ApiExternaHealthIndicatorTest.java
@@ -0,0 +1,41 @@
+package com.example.projeto.health;
+
+import com.example.projeto.integration.CepService;
+import com.example.projeto.integration.Endereco;
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.actuate.health.Health;
+import org.springframework.boot.actuate.health.Status;
+import org.springframework.web.client.ResourceAccessException;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+class ApiExternaHealthIndicatorTest {
+
+    private final CepService cepService = mock(CepService.class);
+    private final ApiExternaHealthIndicator indicador = new ApiExternaHealthIndicator(cepService, "01001000");
+
+    @Test
+    void upQuandoApiExternaResponde() {
+        when(cepService.buscarPorCep("01001000"))
+                .thenReturn(new Endereco("01001-000", "Praca da Se", null, "Se", "Sao Paulo", "SP", null));
+
+        Health health = indicador.health();
+
+        assertThat(health.getStatus()).isEqualTo(Status.UP);
+        assertThat(health.getDetails()).containsEntry("api", "ViaCEP").containsKey("tempoRespostaMs");
+    }
+
+    @Test
+    void downComDetalheQuandoApiExternaFalha() {
+        when(cepService.buscarPorCep("01001000")).thenThrow(new ResourceAccessException("timeout"));
+
+        Health health = indicador.health();
+
+        assertThat(health.getStatus()).isEqualTo(Status.DOWN);
+        assertThat(health.getDetails())
+                .containsEntry("erro", "API externa indisponivel")
+                .containsEntry("causa", "ResourceAccessException");
+    }
+}
